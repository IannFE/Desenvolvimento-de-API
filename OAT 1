//Questao 5
// Analisador Estatistico de Numeros em Array

function analisarNumeros(arrayDeNumeros) {
  if (!arrayDeNumeros || arrayDeNumeros.length === 0) {
    return {
      total: 0,
      maior: null,
      menor: null,
      media: 0,
      pares: 0,
      impares: 0
    };
  }
 
  let soma = 0;
  let maior = arrayDeNumeros[0];
  let menor = arrayDeNumeros[0];
  let pares = 0;
  let impares = 0;
 
  for (const numero of arrayDeNumeros) {
    soma += numero;
 
    if (numero > maior) maior = numero;
    if (numero < menor) menor = numero;
 
    if (numero % 2 === 0) {
      pares++;
    } else {
      impares++;
    }
  }
 
  const media = Math.round((soma / arrayDeNumeros.length) * 100) / 100;
 
  return {
    total: arrayDeNumeros.length,
    maior: maior,
    menor: menor,
    media: media,
    pares: pares,
    impares: impares
  };
}
 
 
