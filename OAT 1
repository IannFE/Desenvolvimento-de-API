// Tabuada Dinamica e Formatada
 
function gerarTabuada(numero, limite = 10) {
  const resultado = [];
 
  for (let i = 1; i <= limite; i++) {
    resultado.push(`${numero} x ${i} = ${numero * i}`);
  }
 
  return resultado;
}
 
 
