//Questao 7
// Contador de Vogais, Consoantes e Espacos

function contarCaracteres(texto) {
  const semAcento = texto.normalize("NFD").replace(/[\u0300-\u036f]/g, "");
  const minusculo = semAcento.toLowerCase();
 
  let vogais = 0;
  let consoantes = 0;
  let espacos = 0;
  let especiais = 0;
 
  const letrasVogais = "aeiou";
 
  for (const letra of minusculo) {
    if (letra === " ") {
      espacos++;
    } else if (letrasVogais.includes(letra)) {
      vogais++;
    } else if (/[a-z]/.test(letra)) {
      consoantes++;
    } else {
      especiais++;
    }
  }
 
  return {
    vogais: vogais,
    consoantes: consoantes,
    espacos: espacos,
    especiais: especiais,
    total: texto.length
  };
}
 
 
