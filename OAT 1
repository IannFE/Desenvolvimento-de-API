// Questao 10
// Sorteador e Distribuidor de Equipes / Times

 
function distribuirTimes(listaDeNomes, quantidadeDeTimes) {
  const embaralhada = [...listaDeNomes];
 
  // Fisher-Yates
  for (let i = embaralhada.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    const temp = embaralhada[i];
    embaralhada[i] = embaralhada[j];
    embaralhada[j] = temp;
  }
 
  const times = [];
  for (let i = 0; i < quantidadeDeTimes; i++) {
    times.push([]);
  }
 
  embaralhada.forEach((nome, indice) => {
    const time = indice % quantidadeDeTimes;
    times[time].push(nome);
  });
 
  return times;
}
 

 
