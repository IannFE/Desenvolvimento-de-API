// Calculadora de IMC com Classificacao OMS

function calcularIMC(peso, altura) {
  const imc = peso / (altura * altura);
  const imcArredondado = Math.round(imc * 100) / 100;
 
  let classificacao;
 
  if (imcArredondado < 18.5) {
    classificacao = "Abaixo do peso";
  } else if (imcArredondado < 25.0) {
    classificacao = "Peso normal";
  } else if (imcArredondado < 30.0) {
    classificacao = "Sobrepeso";
  } else if (imcArredondado < 35.0) {
    classificacao = "Obesidade Grau I";
  } else if (imcArredondado < 40.0) {
    classificacao = "Obesidade Grau II";
  } else {
    classificacao = "Obesidade Grau III";
  }
 
  return {
    imc: imcArredondado,
    classificacao: classificacao
  };
}
 
 
